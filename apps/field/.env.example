# Copy to .env for local Expo development. These are public client values
# protected by Supabase Row Level Security; never put service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
EXPO_PUBLIC_WEB_APP_URL=https://roof-os-lemon.vercel.app
