NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Server-only. Never expose these to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=server_only_supabase_service_role_key
CAPOUT_API_KEY=server_only_capout_key
RAPIDAPI_KEY=server_only_rapidapi_key
LOWES_CLIENT_ID=server_only_lowes_client_id
LOWES_CLIENT_SECRET=server_only_lowes_client_secret
CRON_SECRET=server_only_cron_secret
INTAKE_WORKSPACE_ID=your_workspace_uuid

# Llama / Ollama. Photo intake uses this. Not Grok.
OLLAMA_URL=http://127.0.0.1:11434
LLAMA_VISION_MODEL=llava
# Optional hosted Llama (Groq, Together, etc.)
# LLAMA_VISION_URL=https://api.groq.com/openai/v1
# LLAMA_API_KEY=
# GROQ_API_KEY=

EXPO_PUBLIC_WEB_APP_URL=https://roof-os-lemon.vercel.app

# Mobile field app (Expo public variables)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
EXPO_PUBLIC_WEB_APP_URL=https://roof-os-lemon.vercel.app
