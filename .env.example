NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Server-only. Never expose these to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=server_only_supabase_service_role_key

# Private break-glass owner unlock (required, 16+ chars).
# Open /auth/login and paste the key, or bookmark /auth/enter?key=...
OWNER_ENTER_SECRET=replace_with_long_random_break_glass_secret
# Optional: pin which Auth user to mint (recommended).
OWNER_ENTER_EMAIL=owner@example.com
# Optional password path instead of service-role magic link:
# OWNER_ENTER_PASSWORD=server_only_owner_password
GEMINI_API_KEY=server_only_gemini_api_key
CAPOUT_API_KEY=server_only_capout_key
RAPIDAPI_KEY=server_only_rapidapi_key
LOWES_CLIENT_ID=server_only_lowes_client_id
LOWES_CLIENT_SECRET=server_only_lowes_client_secret
CRON_SECRET=server_only_cron_secret
STRIPE_SECRET_KEY=server_only_stripe_secret_key
STRIPE_WEBHOOK_SECRET=server_only_stripe_webhook_secret
TWILIO_ACCOUNT_SID=server_only_twilio_account_sid
TWILIO_AUTH_TOKEN=server_only_twilio_auth_token
TWILIO_PHONE_NUMBER=server_only_twilio_phone_number
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b
# Explicit opt-in for advisory Llama output in bounded background agents.
LLAMA_AGENT_ENABLED=false
WHISPER_URL=http://127.0.0.1:8088
RECEPTIONIST_WORKSPACE_ID=server_only_workspace_uuid
RECEPTIONIST_OWNER_ID=server_only_owner_uuid
RECEPTIONIST_PUBLIC_URL=https://roof-os-lemon.vercel.app
RECEPTIONIST_TRANSFER_NUMBER=server_only_human_transfer_number

EXPO_PUBLIC_WEB_APP_URL=https://roof-os-lemon.vercel.app

# Mobile field app (Expo public variables)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
EXPO_PUBLIC_WEB_APP_URL=https://roof-os-lemon.vercel.app
